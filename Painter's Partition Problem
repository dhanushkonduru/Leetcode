class Solution {
    public int minTimeToPaint(int[] boards, int k) {
        int low = getMax(boards);
        int high = getSum(boards);
        int result = high;

        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (canPaint(boards, k, mid)) {
                result = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        return result;
    }

    private int getMax(int[] boards) {
        int max = boards[0];
        for (int b : boards) {
            if (b > max)
                max = b;
        }
        return max;
    }

    private int getSum(int[] boards) {
        int sum = 0;
        for (int b : boards)
            sum += b;
        return sum;
    }

    private boolean canPaint(int[] boards, int k, int maxTime) {
        int painters = 1;
        int total = 0;
        for (int b : boards) {
            if (total + b <= maxTime) {
                total += b;
            } else {
                painters++;
                total = b;
                if (painters > k)
                    return false;
            }
        }
        return true;
    }
}
